{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2020"
    ],
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "js",
    "types": [
      "jquery",
      "progressbar.js"
    ],
    "moduleResolution": "node",
    "alwaysStrict": false
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "src/**/*.type-test.ts"
  ]
}
